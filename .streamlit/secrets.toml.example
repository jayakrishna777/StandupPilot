# Streamlit native OIDC configuration for Auth0.
# Copy to .streamlit/secrets.toml and fill in real values; secrets.toml is git-ignored.
# Values must match AUTH0_* in .env. Owner: Developer C (ticket C4).

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
# Random string; keep identical to STREAMLIT_COOKIE_SECRET in .env.
cookie_secret = "replace-with-a-long-random-string"

[auth.auth0]
client_id = "your-auth0-client-id"
client_secret = "your-auth0-client-secret"
server_metadata_url = "https://your-tenant.eu.auth0.com/.well-known/openid-configuration"

[auth.auth0.client_kwargs]
scope = "openid profile email"
prompt = "select_account"
