# StandupPilot local configuration example.
# Copy to .env and fill in real values. .env is git-ignored and must never be committed.
# Every value here is server-side only. Nothing in this file is exposed to the Chrome
# extension or rendered into the Streamlit page.

# ---------------------------------------------------------------------------
# Local service addresses (frozen in Phase 0 - do not change per developer)
# ---------------------------------------------------------------------------
API_BASE_URL=http://localhost:8000
STREAMLIT_BASE_URL=http://localhost:8501
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# PostgreSQL (point this at whatever local server/database you already run;
# no SQLite fallback). Both FastAPI and Streamlit connect through DATABASE_URL.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:your-local-password@localhost:5432/your_database
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=8
# Optional: only set this if you run storage tests against a separate database.
TEST_DATABASE_URL=

# ---------------------------------------------------------------------------
# OpenRouter (model inference)
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Endpoint used by the server-side OpenRouter adapter; never sent to the extension.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Zero-cost default. Pin a more reliable compatible model for the demo if needed.
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://localhost:8501
OPENROUTER_APP_TITLE=StandupPilot
OPENROUTER_TIMEOUT_SECONDS=20
OPENROUTER_MAX_RETRIES=1

# ---------------------------------------------------------------------------
# Jira Cloud (system of record)
# ---------------------------------------------------------------------------
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SP
# Scope the integration account to this fictional demonstration project.
JIRA_PROJECT_KEY=SP
# The single ticket used by the fixed golden-path demonstration.
JIRA_DEMO_ISSUE_KEY=SP-1
JIRA_DEMO_TARGET_STATUS=Done
JIRA_TIMEOUT_SECONDS=15

# ---------------------------------------------------------------------------
# Auth0 (authentication) and reviewer authorization
# ---------------------------------------------------------------------------
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_REDIRECT_URI=http://localhost:8501/oauth2callback
# Auth0 callback URL used by Streamlit's native OIDC flow.
AUTH0_REDIRECT_URI=http://localhost:8501/oauth2callback
# Random string used by Streamlit to sign the login cookie.
STREAMLIT_COOKIE_SECRET=
# Comma-separated Auth0 email identities allowed to approve Jira changes.
# Authentication alone grants no mutation authority.
REVIEWER_ALLOWLIST=reviewer@example.com

# ---------------------------------------------------------------------------
# Caption ingress limits
# ---------------------------------------------------------------------------
MEETING_SESSION_TOKEN_BYTES=32
MAX_CAPTION_CHARS=1000
